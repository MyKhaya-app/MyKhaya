# DEV shared policy -> /etc/mykhaya/dev/common.env (non-secret). Loaded by api,
# worker and scheduler, which must agree on these values. URLs, hosts, CORS,
# environment, cookie and MFA policy are pinned by compose.dev.yml and must NOT
# be repeated here; the validator rejects pinned names.
MYKHAYA_MONITORING_ENABLED=true
MYKHAYA_SENSITIVE_FIELD_KEYS_REQUIRED=false
MYKHAYA_DRIVEWAY_FIELD_ENCRYPTION_WRITE=false
MYKHAYA_DRIVEWAY_FIELD_ENCRYPTION_READ=false
# Only when keyrings are provisioned as files in the read-only mount:
# MYKHAYA_FIELD_ENCRYPTION_KEYS_FILE=/run/secrets/mykhaya/field-encryption-keys.json
# MYKHAYA_BLIND_INDEX_KEYS_FILE=/run/secrets/mykhaya/blind-index-keys.json
