# DEV PostgreSQL -> /etc/mykhaya/dev/postgres.env (mode 0600).
# Bootstrap values only. init-db.sh applies them on first initialisation; an
# existing data volume keeps its passwords, so copy the CURRENT values from the
# DEV root (MYKHAYA_POSTGRES_ADMIN_PASSWORD there becomes POSTGRES_PASSWORD here).
POSTGRES_PASSWORD=__SET_IN_IGNORED_DEV_FILE__
MYKHAYA_MIGRATION_DB_PASSWORD=__SET_IN_IGNORED_DEV_FILE__
MYKHAYA_DB_PASSWORD=__SET_IN_IGNORED_DEV_FILE__
