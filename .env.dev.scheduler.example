# DEV scheduler -> /etc/mykhaya/dev/scheduler.env (mode 0600 or 0640).
# Scheduling plus the service-monitoring runner. The runner authenticates to
# SMTP and Stripe and decides DVLA/DVSA applicability from credential presence,
# so supply a provider group here ONLY when that provider is configured through
# the environment (not the Platform Control Centre), with values identical to
# api.env. Omitting an environment-configured provider makes monitoring report
# it as not applicable.
MYKHAYA_DATABASE_URL=postgresql+asyncpg://mykhaya_app:__SET_IN_IGNORED_DEV_FILE__@postgres:5432/mykhaya
MYKHAYA_REDIS_URL=redis://redis:6379/0
MYKHAYA_SECRET_KEY=__SET_IN_IGNORED_DEV_FILE__
MYKHAYA_MONITORING_WEB_URL=
MYKHAYA_MONITORING_API_URL=
# Optional external dead-man's switch (a secret). Scheduler-only.
MYKHAYA_MONITORING_WATCHDOG_URL=
# JWKS reachability checks need only the enabled flags, never a secret.
MYKHAYA_APPLE_SIGN_IN_ENABLED=false
MYKHAYA_GOOGLE_SIGN_IN_ENABLED=false
# Environment-configured SMTP: MYKHAYA_SMTP_HOST, _PORT, _USERNAME, _PASSWORD,
#   _CONNECTION_SECURITY, MYKHAYA_EMAIL_DELIVERY_CONFIGURED, MYKHAYA_EMAIL_FROM
# Environment-configured Stripe: MYKHAYA_STRIPE_BILLING_CONFIGURED,
#   MYKHAYA_STRIPE_SECRET_KEY, MYKHAYA_STRIPE_WEBHOOK_SECRET,
#   MYKHAYA_STRIPE_FAMILY_MONTHLY_PRICE_ID, MYKHAYA_STRIPE_FAMILY_ANNUAL_PRICE_ID
# DVLA: MYKHAYA_DVLA_ENVIRONMENT plus ONLY the selected environment's endpoint and
#   key (the other environment's pair is rejected)
# DVSA: MYKHAYA_DVSA_ENABLED, _API_BASE_URL, _TOKEN_URL, _CLIENT_ID, _CLIENT_SECRET,
#   _API_KEY (no _SCOPE or _ENVIRONMENT: monitoring never reads them)
