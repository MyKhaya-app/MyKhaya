# Copy to .env on the isolated production host. Never commit the real file.
MYKHAYA_ENVIRONMENT=production
MYKHAYA_REGISTRATION_MODE=invitation_only
MYKHAYA_SECRET_KEY=GENERATE_A_UNIQUE_32_PLUS_CHARACTER_SECRET
MYKHAYA_POSTGRES_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
MYKHAYA_MIGRATION_DB_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
MYKHAYA_DB_PASSWORD=GENERATE_A_DIFFERENT_UNIQUE_PASSWORD
MYKHAYA_REDIS_URL=redis://redis:6379/0
MYKHAYA_PUBLIC_WEB_URL=https://mykhaya.app
MYKHAYA_ADMIN_URL=https://admin.mykhaya.app
MYKHAYA_STATUS_URL=https://status.mykhaya.app
MYKHAYA_NATIVE_API_URL=https://mykhaya.app/api/v1
MYKHAYA_CORS_ORIGINS=["https://mykhaya.app","https://admin.mykhaya.app"]
MYKHAYA_TRUSTED_HOSTS=["mykhaya.app","admin.mykhaya.app","status.mykhaya.app","api"]
MYKHAYA_TRUSTED_PROXY_CIDRS=["100.64.0.0/10","172.16.0.0/12"]
MYKHAYA_CADDY_TRUSTED_PROXY_CIDRS=REPLACE_WITH_EXACT_NETBIRD_PROXY_CIDRS
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["REPLACE_WITH_HOME_IPV4_32"]
MYKHAYA_COOKIE_SECURE=true
MYKHAYA_ADMIN_MFA_REQUIRED=true
MYKHAYA_ADMIN_BOOTSTRAP_ENABLED=false
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true
MYKHAYA_EMAIL_FROM=MyKhaya <hello@mykhaya.app>
MYKHAYA_SMTP_HOST=REPLACE_WITH_PRODUCTION_SMTP_HOST
MYKHAYA_SMTP_PORT=587
MYKHAYA_SMTP_CONNECTION_SECURITY=starttls
MYKHAYA_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
MYKHAYA_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_TEAM_ID=
MYKHAYA_APNS_KEY_ID=
MYKHAYA_APNS_BUNDLE_ID=app.mykhaya.mobile
MYKHAYA_APNS_PRIVATE_KEY=
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_ACQUISITION_ENABLED=false
MYKHAYA_BACKUP_DIR=/var/lib/mykhaya/backups
MYKHAYA_PRODUCTION=1
WEB_DOMAIN=mykhaya.app
ADMIN_DOMAIN=admin.mykhaya.app
STATUS_DOMAIN=status.mykhaya.app
