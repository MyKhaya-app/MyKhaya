# Copy to .env on the isolated production host. Never commit the real file.
MYKHAYA_ENVIRONMENT=production
# Deployment ceiling for signup. Keep this `open` when PCC should own signup,
# Beta and waitlist controls; use `invitation_only` only as an intentional,
# deployment-wide restriction. Existing PCC rows still take precedence within
# the ceiling and are never overwritten by a release checkout.
MYKHAYA_REGISTRATION_MODE=open
MYKHAYA_SECRET_KEY=GENERATE_A_UNIQUE_32_PLUS_CHARACTER_SECRET
MYKHAYA_POSTGRES_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
MYKHAYA_MIGRATION_DB_PASSWORD=GENERATE_A_UNIQUE_PASSWORD
MYKHAYA_DB_PASSWORD=GENERATE_A_DIFFERENT_UNIQUE_PASSWORD
MYKHAYA_REDIS_URL=redis://redis:6379/0
MYKHAYA_PUBLIC_WEB_URL=https://mykhaya.app
MYKHAYA_ADMIN_URL=https://admin.mykhaya.app
MYKHAYA_STATUS_URL=https://status.mykhaya.app
MYKHAYA_NATIVE_API_URL=https://api.mykhaya.app
MYKHAYA_CORS_ORIGINS=["https://mykhaya.app","https://admin.mykhaya.app"]
MYKHAYA_TRUSTED_HOSTS=["mykhaya.app","api.mykhaya.app","admin.mykhaya.app","status.mykhaya.app","api"]
MYKHAYA_TRUSTED_PROXY_CIDRS=["100.64.0.0/10","172.16.0.0/12"]
MYKHAYA_CADDY_TRUSTED_PROXY_CIDRS=REPLACE_WITH_EXACT_NETBIRD_PROXY_CIDRS
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["REPLACE_WITH_HOME_IPV4_32"]
MYKHAYA_COOKIE_SECURE=true
MYKHAYA_ADMIN_MFA_REQUIRED=true
MYKHAYA_ADMIN_BOOTSTRAP_ENABLED=false
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true
MYKHAYA_EMAIL_FROM=MyKhaya <hello@mykhaya.app>
MYKHAYA_SMTP_HOST=REPLACE_WITH_PRODUCTION_SMTP_HOST
MYKHAYA_SMTP_PORT=587
MYKHAYA_SMTP_CONNECTION_SECURITY=starttls
MYKHAYA_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
MYKHAYA_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_TEAM_ID=
MYKHAYA_APNS_KEY_ID=
MYKHAYA_APNS_BUNDLE_ID=app.mykhaya.mobile
MYKHAYA_APNS_PRIVATE_KEY=
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_ACQUISITION_ENABLED=false
# Driveway / DVLA Vehicle Enquiry Service — left unconfigured by default.
# This pass does not enable production DVLA calls; a deliberate operator
# sets MYKHAYA_DVLA_ENVIRONMENT=production and both values below only when
# actually going live. See docs/operations/deployment.md#driveway-dvla-integration-uat.
MYKHAYA_DVLA_ENVIRONMENT=
MYKHAYA_DVLA_UAT_ENDPOINT=
MYKHAYA_DVLA_UAT_API_KEY=
MYKHAYA_DVLA_PRODUCTION_ENDPOINT=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
MYKHAYA_DVLA_PRODUCTION_API_KEY=
MYKHAYA_BACKUP_DIR=/var/lib/mykhaya/backups
# age PUBLIC recipient(s) for backup encryption. The private identity is kept
# offline and is never placed on this host. backup.sh refuses to run in
# production without this file. See docs/operations/backup-and-restore.md.
MYKHAYA_BACKUP_AGE_RECIPIENTS_FILE=/etc/mykhaya/backup-recipients.txt
# Sensitive-field keyrings (mykhaya.crypto): host directory bind-mounted
# read-only into api/worker/scheduler only. Keep it outside the checkout and
# outside every backed-up path. Never set MYKHAYA_FIELD_ENCRYPTION_KEYS /
# MYKHAYA_BLIND_INDEX_KEYS in production — startup rejects them.
# See docs/operations/sensitive-field-keys.md.
MYKHAYA_FIELD_KEYS_HOST_DIR=/etc/mykhaya/field-keys
MYKHAYA_SENSITIVE_FIELD_KEYS_REQUIRED=false
# Phase 2B Driveway registration/VIN dual-write. Keep false in production
# until the Phase 2B gate (key-escrow recovery exercise + encrypted-backup
# restore test) has passed. See docs/operations/sensitive-field-keys.md.
MYKHAYA_DRIVEWAY_FIELD_ENCRYPTION_WRITE=false
# Home Migration package files that have not completed an import are purged
# after this many hours (completed imports are removed immediately).
MYKHAYA_HOME_MIGRATION_PACKAGE_TTL_HOURS=24
MYKHAYA_PRODUCTION=1
WEB_DOMAIN=mykhaya.app
API_DOMAIN=api.mykhaya.app
ADMIN_DOMAIN=admin.mykhaya.app
STATUS_DOMAIN=status.mykhaya.app
