MYKHAYA_ENVIRONMENT=test
MYKHAYA_SECRET_KEY=test-only-secret-key-never-used-in-production-1234
MYKHAYA_DATABASE_URL=postgresql+asyncpg://mykhaya_app:synthetic-app-password@postgres:5432/mykhaya
MYKHAYA_REDIS_URL=redis://redis:6379/0
# Test-suite contract, mirrored from the compose.yml `test` service overrides
# and the .env.example defaults that CI (quality.yml) runs the suite with. The
# suite's ASGI client uses these localhost origins/hosts; narrower values make
# the origin guard reject nearly every mutating request.
MYKHAYA_PUBLIC_WEB_URL=http://localhost:8080
MYKHAYA_ADMIN_URL=http://admin.localhost:8080
MYKHAYA_STATUS_URL=http://status.localhost:8080
MYKHAYA_TRUSTED_HOSTS=["localhost","127.0.0.1","admin.localhost","status.localhost"]
MYKHAYA_CORS_ORIGINS=["http://localhost:8080","http://admin.localhost:8080"]
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
MYKHAYA_TRUSTED_PROXY_CIDRS=["172.16.0.0/24"]
MYKHAYA_ADMIN_MFA_REQUIRED=false
MYKHAYA_COOKIE_SECURE=false
MYKHAYA_RATE_LIMIT_LOGIN=1000
MYKHAYA_RATE_LIMIT_REGISTER=1000
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true
MYKHAYA_AVATAR_STORAGE_DIR=/tmp/avatars
MYKHAYA_SUPPORT_ATTACHMENT_STORAGE_DIR=/tmp/support-attachments
MYKHAYA_VEHICLE_PHOTO_STORAGE_DIR=/tmp/vehicle-photos
MYKHAYA_LEGAL_EVIDENCE_STORAGE_DIR=/tmp/legal-evidence
COVERAGE_FILE=/tmp/.coverage
# Every external provider is disabled; tests mock provider calls in code, and
# the internal f03-data network has no egress in any case.
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
MYKHAYA_FCM_DELIVERY_CONFIGURED=false
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_DELIVERY_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_DVLA_ENVIRONMENT=
MYKHAYA_DVSA_ENABLED=false
MYKHAYA_APPLE_SIGN_IN_ENABLED=false
MYKHAYA_GOOGLE_SIGN_IN_ENABLED=false
