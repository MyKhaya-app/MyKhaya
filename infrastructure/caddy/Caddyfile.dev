{
	http_port 8080
	servers {
		trusted_proxies static {$MYKHAYA_DEV_PROXY_TRUSTED_CIDRS:100.64.0.0/10}
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# PCC-SEC-008: no legitimate reason for any MyKhaya origin to be framed.
		X-Frame-Options DENY
		?Content-Security-Policy "frame-ancestors 'none'"
	}
}

# PCC-SEC-008: the full nonce-bearing PCC CSP is generated by
# apps/web/middleware.ts. A static policy here would replace its per-request
# nonce and block Next.js inline bootstrap scripts.
(admin_security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options DENY
	}
}

(public_development_site) {
	encode zstd gzip
	request_body {
		# Coarse edge limit; the API retains its tighter JSON limit and 5 MB avatar allowance.
		max_size 10MB
	}
	@api path /api/*
	reverse_proxy @api api:8000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {client_ip}
	}
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {client_ip}
	}
	log {
		output stdout
		format json
	}
}

http://dev.mykhaya.app,
http://status.dev.mykhaya.app {
	import public_development_site
	import security_headers
}

http://admin.dev.mykhaya.app {
	import public_development_site
	import admin_security_headers
}

# Direct-to-API origin for native/bearer clients (ADR 0010) — the dev
# equivalent of production's api.mykhaya.app. Deliberately never proxies to
# web:3000 and has no /api/* path matcher: every request on this host goes
# straight to FastAPI, exactly like production's api.mykhaya.app. Not a
# browser-facing origin, so it carries the plain security_headers set, not
# admin_security_headers, and is never added to CORS_ORIGINS.
http://api.dev.mykhaya.app {
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {client_ip}
	}
	import security_headers
	log {
		output stdout
		format json
	}
}

http://localhost, http://127.0.0.1, http://status.localhost {
	encode zstd gzip
	@api path /api/*
	reverse_proxy @api api:8000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-For {remote_host}
	}
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-For {remote_host}
	}
	import security_headers
	log {
		output stdout
		format json
	}
}

http://admin.localhost {
	encode zstd gzip
	@api path /api/*
	reverse_proxy @api api:8000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-For {remote_host}
	}
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-For {remote_host}
	}
	import admin_security_headers
	log {
		output stdout
		format json
	}
}

# Direct-to-API origin for native/bearer clients (ADR 0010), pure-local
# equivalent of api.dev.mykhaya.app above — same rationale.
http://api.localhost {
	encode zstd gzip
	reverse_proxy api:8000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-For {remote_host}
	}
	import security_headers
	log {
		output stdout
		format json
	}
}

# Fail closed when a request reaches the local listener with an unrecognised
# Host header instead of receiving Caddy's empty default response.
:8080 {
	respond "Misdirected Request" 421
}
