{$WEB_DOMAIN:mykhaya.app} {
	encode zstd gzip
	@api path /api/*
	reverse_proxy @api api:8000
	reverse_proxy web:3000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# PCC-SEC-008: no legitimate reason for any MyKhaya origin to be
		# framed by another site — frame-ancestors (modern) plus
		# X-Frame-Options (older-browser fallback) both deny it outright.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	log {
		output stdout
		format json
	}
}
{$API_DOMAIN:api.mykhaya.app} {
	encode zstd gzip
	reverse_proxy api:8000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	log {
		output stdout
		format json
	}
}

{$ADMIN_DOMAIN:admin.mykhaya.app} {
	encode zstd gzip
	@api path /api/*
	reverse_proxy @api api:8000
	reverse_proxy web:3000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options DENY
		# PCC-SEC-008: the full nonce-bearing PCC CSP is generated by
		# apps/web/middleware.ts. A static policy here would replace its
		# per-request nonce and block Next.js inline bootstrap scripts.
	}
	log {
		output stdout
		format json
	}
}

{$STATUS_DOMAIN:status.mykhaya.app} {
	encode zstd gzip
	@api path /api/*
	reverse_proxy @api api:8000
	reverse_proxy web:3000
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}
	log {
		output stdout
		format json
	}
}
