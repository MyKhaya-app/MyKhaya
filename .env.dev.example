# MyKhaya persistent development-server configuration.
# Copy this file to .env, replace every CHANGE_ME value, and never commit .env.

# Host publishing. Use 0.0.0.0 so NetBird Proxy can reach the server's NetBird IP.
MYKHAYA_DEV_BIND_ADDRESS=0.0.0.0
MYKHAYA_DEV_HOST_PORT=8080
# Mailpit remains loopback-only regardless of the application bind address.
MYKHAYA_DEV_MAILPIT_PORT=8025

# Caddy trusts X-Forwarded-For only from these NetBird proxy source networks.
# Prefer the exact NetBird Proxy peer address as a /32 when it is known.
# This is a space-separated Caddy CIDR list, not JSON.
MYKHAYA_DEV_PROXY_TRUSTED_CIDRS=100.64.0.0/10

# Database and application secrets. Generate independent, high-entropy values.
MYKHAYA_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MYKHAYA_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_ADMIN_PASSWORD
MYKHAYA_MIGRATION_DB_PASSWORD=CHANGE_ME_RANDOM_MIGRATION_PASSWORD
MYKHAYA_DB_PASSWORD=CHANGE_ME_RANDOM_RUNTIME_PASSWORD

# Internal service connection. PostgreSQL and Redis are never published to the host.
MYKHAYA_REDIS_URL=redis://redis:6379/0

# Canonical HTTPS URLs presented by NetBird Proxy.
MYKHAYA_PUBLIC_WEB_URL=https://dev.mykhaya.app
MYKHAYA_ADMIN_URL=https://admin.dev.mykhaya.app
MYKHAYA_STATUS_URL=https://status.dev.mykhaya.app
MYKHAYA_CORS_ORIGINS=["https://dev.mykhaya.app","https://admin.dev.mykhaya.app","https://status.dev.mykhaya.app"]
MYKHAYA_TRUSTED_HOSTS=["dev.mykhaya.app","admin.dev.mykhaya.app","status.dev.mykhaya.app","localhost","127.0.0.1","api"]
MYKHAYA_COOKIE_SECURE=true

# API trusts only the private Docker network where Caddy connects from.
MYKHAYA_TRUSTED_PROXY_CIDRS=["172.16.0.0/12"]
# Restrict Control Centre access to operator NetBird addresses; prefer exact /32s.
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["100.64.0.0/10"]

# Development servers may disable admin MFA until WebAuthn is available.
# Production validation still requires MFA and is unchanged.
MYKHAYA_ADMIN_MFA_REQUIRED=false
MYKHAYA_ADMIN_BOOTSTRAP_ENABLED=false
MYKHAYA_STATUS_PUBLIC_ENABLED=true

# Development behavior. The compose overlay enforces these safety-critical values.
MYKHAYA_ENVIRONMENT=development
MYKHAYA_BUILD_CHANNEL=development
MYKHAYA_REGISTRATION_MODE=open

# Mailpit captures development mail locally at http://127.0.0.1:8025.
MYKHAYA_SMTP_HOST=mailpit
MYKHAYA_SMTP_PORT=1025
MYKHAYA_SMTP_USERNAME=
MYKHAYA_SMTP_PASSWORD=
MYKHAYA_SMTP_STARTTLS=false
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=true
MYKHAYA_EMAIL_FROM=MyKhaya <hello@dev.mykhaya.app>
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true

# Web Push (VAPID). Leave MYKHAYA_PUSH_DELIVERY_CONFIGURED=false to manage keys from
# the Platform Admin Push page instead (recommended — see docs/architecture/
# platform-control-centre.md "Push configuration precedence"). Only set these three if
# you want push managed entirely from the deployment environment.
MYKHAYA_VAPID_PUBLIC_KEY=
MYKHAYA_VAPID_PRIVATE_KEY=
MYKHAYA_VAPID_SUBJECT=
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false

# Administrative session policy.
MYKHAYA_ADMIN_SESSION_IDLE_MINUTES=15
MYKHAYA_ADMIN_SESSION_ABSOLUTE_MINUTES=480
MYKHAYA_ADMIN_RECENT_AUTH_MINUTES=10

# Regional defaults.
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday

# Optional build metadata. Deployment commands populate these automatically.
MYKHAYA_VERSION=
MYKHAYA_COMMIT_SHA=unknown
MYKHAYA_BUILD_TIME=unknown
