# DEV API -> /etc/mykhaya/dev/api.env (mode 0600 or 0640). Copy each value from
# the variable of the same name in the current DEV root .env; never invent one.
# Database: the runtime role, with MYKHAYA_DB_PASSWORD from postgres.env.
MYKHAYA_DATABASE_URL=postgresql+asyncpg://mykhaya_app:__SET_IN_IGNORED_DEV_FILE__@postgres:5432/mykhaya
MYKHAYA_REDIS_URL=redis://redis:6379/0
# Identical in api, worker, scheduler and migrate.
MYKHAYA_SECRET_KEY=__SET_IN_IGNORED_DEV_FILE__
MYKHAYA_SESSION_MINUTES=20160
MYKHAYA_TRUSTED_DEVICE_DAYS=90
MYKHAYA_TRUSTED_DEVICE_ACTIVITY_UPDATE_HOURS=24
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true
MYKHAYA_ADMIN_BOOTSTRAP_ENABLED=false
MYKHAYA_STATUS_PUBLIC_ENABLED=true
MYKHAYA_ADMIN_SESSION_IDLE_MINUTES=15
MYKHAYA_ADMIN_SESSION_ABSOLUTE_MINUTES=480
MYKHAYA_ADMIN_RECENT_AUTH_MINUTES=10
# Monitoring targets (blank = internal Docker addresses). The watchdog URL is
# scheduler-only and is rejected here.
MYKHAYA_MONITORING_WEB_URL=
MYKHAYA_MONITORING_API_URL=
# SMTP: the Control Centre test-email action sends from the API. Must match worker.
MYKHAYA_SMTP_HOST=mailpit
MYKHAYA_SMTP_PORT=1025
MYKHAYA_SMTP_USERNAME=
MYKHAYA_SMTP_CONNECTION_SECURITY=none
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
MYKHAYA_EMAIL_FROM=MyKhaya <hello@dev.mykhaya.app>
# MYKHAYA_SMTP_PASSWORD=
# Web Push and FCM status/test actions in the Control Centre. APNs is worker-only.
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false
MYKHAYA_FCM_DELIVERY_CONFIGURED=false
# MYKHAYA_VAPID_PUBLIC_KEY= / MYKHAYA_VAPID_PRIVATE_KEY= / MYKHAYA_VAPID_SUBJECT=
# MYKHAYA_FCM_PROJECT_ID= / MYKHAYA_FCM_CLIENT_EMAIL= / MYKHAYA_FCM_PRIVATE_KEY=
# Apple and Google sign-in: the DEV registrations only.
MYKHAYA_APPLE_SIGN_IN_ENABLED=false
MYKHAYA_GOOGLE_SIGN_IN_ENABLED=false
# MYKHAYA_APPLE_PRIVATE_KEY_FILE=/run/secrets/mykhaya-apple/apple-sign-in.p8
# MYKHAYA_APPLE_SERVICE_ID= / MYKHAYA_APPLE_NATIVE_CLIENT_ID= / MYKHAYA_APPLE_TEAM_ID=
# MYKHAYA_APPLE_KEY_ID= / MYKHAYA_GOOGLE_CLIENT_ID= / MYKHAYA_GOOGLE_CLIENT_SECRET=
# Stripe: sandbox (test-mode) values only; live-mode keys are rejected in DEV.
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_ACQUISITION_ENABLED=false
MYKHAYA_STRIPE_ULTIMATE_ACQUISITION_ENABLED=false
# MYKHAYA_STRIPE_SECRET_KEY= / MYKHAYA_STRIPE_WEBHOOK_SECRET= / price IDs
# DVLA: DEV is authorised to use either environment; keep the current value.
MYKHAYA_DVLA_ENVIRONMENT=
# MYKHAYA_DVLA_PRODUCTION_ENDPOINT= / MYKHAYA_DVLA_PRODUCTION_API_KEY=
# MYKHAYA_DVLA_UAT_ENDPOINT= / MYKHAYA_DVLA_UAT_API_KEY=
MYKHAYA_DVSA_ENABLED=false
# MYKHAYA_DVSA_ENVIRONMENT= / MYKHAYA_DVSA_TOKEN_URL= / MYKHAYA_DVSA_CLIENT_ID=
# MYKHAYA_DVSA_CLIENT_SECRET= / MYKHAYA_DVSA_API_KEY= / MYKHAYA_DVSA_SCOPE=
