# Synthetic test configuration. Tracked, never copied to the DEV host and never
# populated with real values. compose.dev.service-env.yml loads it directly for
# the test service; its hosts exist only in the isolated compose.test.yml stack.
MYKHAYA_ENVIRONMENT=test
MYKHAYA_SECRET_KEY=synthetic-test-secret-value-only-0123456789
MYKHAYA_DATABASE_URL=postgresql+asyncpg://mykhaya_app:synthetic-password@postgres-test:5432/mykhaya
MYKHAYA_REDIS_URL=redis://redis-test:6379/0
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
MYKHAYA_FCM_DELIVERY_CONFIGURED=false
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false
MYKHAYA_APNS_DELIVERY_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_DVSA_ENABLED=false
MYKHAYA_APPLE_SIGN_IN_ENABLED=false
MYKHAYA_GOOGLE_SIGN_IN_ENABLED=false
