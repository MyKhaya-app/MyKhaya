# DEV migrations -> /etc/mykhaya/dev/migrate.env (mode 0600 or 0640).
# The migration-privileged role, with MYKHAYA_MIGRATION_DB_PASSWORD from postgres.env.
MYKHAYA_DATABASE_URL=postgresql+asyncpg://mykhaya_migrator:__SET_IN_IGNORED_DEV_FILE__@postgres:5432/mykhaya
# Compatibility only: Alembic constructs the full Settings model at import time.
# Same value as api.env until a separate, approved settings change removes it.
MYKHAYA_SECRET_KEY=__SET_IN_IGNORED_DEV_FILE__
