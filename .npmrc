engine-strict=true
minimum-release-age=10080
strict-peer-dependencies=true

# @expo/cli resolves some Metro internals (e.g. metro-runtime) as implicit
# "phantom" dependencies from the root node_modules, which pnpm's default
# isolated linking doesn't provide. Full `nodeLinker=hoisted` (Expo's
# documented monorepo fix) was tried and rejected: it broke apps/web's
# production build with a duplicate-React-instances error
# ("Cannot read properties of null (reading 'useRef')") during
# prerendering. This narrower fix hoists only the Metro-family packages to
# the root, leaving every other package's resolution isolated as before -
# apps/web is unaffected.
public-hoist-pattern[]=*metro*

