# Local developer workstation override — copy this file to compose.override.yml
# (untracked, see .gitignore) and adjust if needed. `make up`/`make build`/`docker
# compose` with no `-f` flags auto-merge compose.yml with compose.override.yml, so
# this is the ONLY compose file responsible for publishing Caddy to your host for
# local development — see docs/operations/local-development.md.
#
# This intentionally mirrors the port compose.dev.yml uses for the separate
# persistent-dev-server workflow (MYKHAYA_DEV_HOST_PORT/MYKHAYA_DEV_BIND_ADDRESS),
# so the two workflows read consistently even though they are never combined
# with each other. Defaults to 8080, matching .env.example's MYKHAYA_ADMIN_URL /
# MYKHAYA_STATUS_URL / MYKHAYA_PUBLIC_WEB_URL / MYKHAYA_CORS_ORIGINS /
# MYKHAYA_TRUSTED_HOSTS defaults — if you change the port here, change the port in
# those .env values too (infrastructure/caddy/Caddyfile's site addresses are the
# only piece that's fixed at 8080 container-side; this maps your chosen host port
# to that).
services:
  caddy:
    ports:
      - "${MYKHAYA_DEV_BIND_ADDRESS:-0.0.0.0}:${MYKHAYA_DEV_HOST_PORT:-8080}:8080"
    # A static, known-in-advance address on each network, deliberately high
    # (.250) so it never collides with the low addresses Docker auto-assigns
    # to api/web/worker/scheduler/migrate. This workstation's
    # MYKHAYA_TRUSTED_PROXY_CIDRS (.env.example) trusts exactly these two
    # /32s — see the `networks:` block below for why the subnet itself (an
    # earlier draft of this fix) must not be trusted instead.
    networks:
      edge:
        ipv4_address: 10.77.0.250
      app:
        ipv4_address: 10.77.1.250

# Pin the `edge`/`app` subnets compose.yml declares with no `ipam`, purely so
# caddy above can have a static address at all — trusting the whole subnet
# was tried and rejected: `edge` is non-internal (api/worker/scheduler need
# it for outbound SMTP/APNs/FCM), and its gateway address — what Docker's
# NAT makes every host-published-port request appear to come from — sits
# inside that same subnet. A trust boundary keyed on the whole /24 would
# treat that gateway as just another trusted hop and let a forged
# X-Forwarded-For chain walk straight past it to an attacker's value
# (confirmed live with a forged header before switching to this /32 form).
# See compose.dev.yml's matching block (the persistent-dev-server workflow
# needs the identical fix) for the full rationale.
networks:
  edge:
    ipam:
      config:
        - subnet: 10.77.0.0/24
  app:
    ipam:
      config:
        - subnet: 10.77.1.0/24
