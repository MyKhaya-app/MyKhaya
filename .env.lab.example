# Copy to .env.lab and replace every CHANGE_ME value. Never commit .env.lab.
MYKHAYA_ENVIRONMENT=lab
MYKHAYA_REGISTRATION_MODE=open
MYKHAYA_BUILD_CHANNEL=lab
MYKHAYA_NODE_ID=mk-lab-01
MYKHAYA_REGION=uk

# Generate independently from .env and any development/production secret.
MYKHAYA_SECRET_KEY=CHANGE_ME_LAB_SECRET_32_RANDOM_CHARACTERS
MYKHAYA_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LAB_POSTGRES_ADMIN
MYKHAYA_MIGRATION_DB_PASSWORD=CHANGE_ME_LAB_MIGRATION
MYKHAYA_DB_PASSWORD=CHANGE_ME_LAB_RUNTIME
MYKHAYA_REDIS_URL=redis://redis:6379/0

MYKHAYA_PUBLIC_WEB_URL=https://lab.mykhaya.app
MYKHAYA_ADMIN_URL=https://admin.lab.mykhaya.app
MYKHAYA_STATUS_URL=https://status.lab.mykhaya.app
MYKHAYA_NATIVE_API_URL=https://api.lab.mykhaya.app
MYKHAYA_CORS_ORIGINS=["https://lab.mykhaya.app","https://admin.lab.mykhaya.app","https://status.lab.mykhaya.app"]
MYKHAYA_TRUSTED_HOSTS=["lab.mykhaya.app","admin.lab.mykhaya.app","status.lab.mykhaya.app","api.lab.mykhaya.app","localhost","127.0.0.1","api"]
MYKHAYA_COOKIE_SECURE=true
# Safe default for local-only Lab. Replace with a narrow operator/VPN CIDR for remote access.
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
MYKHAYA_ADMIN_MFA_REQUIRED=true
MYKHAYA_TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]
CADDY_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# Non-delivering Lab mail only.
MYKHAYA_SMTP_HOST=mailpit
MYKHAYA_SMTP_PORT=1025
MYKHAYA_SMTP_CONNECTION_SECURITY=none
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=true
MYKHAYA_EMAIL_FROM=MyKhaya Lab <lab@mykhaya.invalid>
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true

# APNs is deliberately disabled until a separate Lab provider is approved.
MYKHAYA_APNS_DELIVERY_CONFIGURED=false
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false

# Stripe test mode only. Replace all values with Stripe test-mode values.
MYKHAYA_STRIPE_SECRET_KEY=sk_test_CHANGE_ME
MYKHAYA_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
MYKHAYA_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
MYKHAYA_STRIPE_FAMILY_MONTHLY_PRICE_ID=price_test_CHANGE_ME_MONTHLY
MYKHAYA_STRIPE_FAMILY_ANNUAL_PRICE_ID=price_test_CHANGE_ME_ANNUAL
MYKHAYA_STRIPE_BILLING_CONFIGURED=true
MYKHAYA_STRIPE_BILLING_ACQUISITION_ENABLED=false

# Used only by make lab-seed; store locally and never commit.
MYKHAYA_LAB_FIXTURE_PASSWORD=CHANGE_ME_LAB_FIXTURE_PASSWORD
MYKHAYA_LAB_BIND_ADDRESS=127.0.0.1
MYKHAYA_LAB_HTTP_PORT=8081
MYKHAYA_LAB_HTTPS_PORT=8444
MYKHAYA_LAB_MAILPIT_PORT=18025
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday
MYKHAYA_STATUS_PUBLIC_ENABLED=true
