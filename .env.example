MYKHAYA_ENVIRONMENT=development
MYKHAYA_REGISTRATION_MODE=open
MYKHAYA_SECRET_KEY=replace-with-at-least-32-cryptographically-random-characters
MYKHAYA_POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-password
MYKHAYA_MIGRATION_DB_PASSWORD=replace-with-a-random-migration-password
MYKHAYA_DB_PASSWORD=replace-with-a-different-random-runtime-password
MYKHAYA_REDIS_URL=redis://redis:6379/0
# These four assume Caddy is published on host port 8080 by compose.override.yml
# (copied from compose.override.yml.example — see docs/operations/local-development.md).
# If 8080 is already taken on your machine, change the port in all of: this URL,
# ADMIN_URL, STATUS_URL, CORS_ORIGINS, TRUSTED_HOSTS below, AND
# compose.override.yml's MYKHAYA_DEV_HOST_PORT (or its ports: line directly).
MYKHAYA_PUBLIC_WEB_URL=http://localhost:8080
MYKHAYA_ADMIN_URL=http://admin.localhost:8080
MYKHAYA_STATUS_URL=http://status.localhost:8080
# Direct-to-API origin for native/bearer clients (ADR 0010) — never proxied
# through the web app. Not a browser-facing origin, so it does not need to
# be in MYKHAYA_CORS_ORIGINS, only MYKHAYA_TRUSTED_HOSTS below.
MYKHAYA_NATIVE_API_URL=http://api.localhost:8080
MYKHAYA_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://admin.localhost:8080","http://status.localhost:8080","http://host.docker.internal:8080"]
MYKHAYA_TRUSTED_HOSTS=["localhost","127.0.0.1","host.docker.internal","api","mykhaya.app","api.mykhaya.app","admin.mykhaya.app","status.mykhaya.app","admin.localhost","status.localhost","api.localhost"]
MYKHAYA_COOKIE_SECURE=false
# Short-lived browser application session. Trusted family devices silently
# renew this session; Platform Control Centre sessions are separate.
MYKHAYA_SESSION_MINUTES=20160
MYKHAYA_TRUSTED_DEVICE_DAYS=90
MYKHAYA_TRUSTED_DEVICE_ACTIVITY_UPDATE_HOURS=24
# Optional isolated-local fallback: Mailpit (compose.yml), no auth, no TLS. Normal
# application email uses the enabled Platform Control Centre SMTP configuration,
# which always takes precedence over these values. For isolated local Mailpit testing,
# explicitly set MYKHAYA_EMAIL_DELIVERY_CONFIGURED=true. Production should configure
# SMTP in the Platform Control Centre; environment SMTP is not an application fallback.
MYKHAYA_SMTP_HOST=mailpit
MYKHAYA_SMTP_PORT=1025
MYKHAYA_SMTP_USERNAME=
MYKHAYA_SMTP_PASSWORD=
# none | starttls | tls (tls = implicit TLS, typically port 465)
MYKHAYA_SMTP_CONNECTION_SECURITY=none
MYKHAYA_SMTP_TIMEOUT_SECONDS=10
# Optional: only if replies should go somewhere other than MYKHAYA_EMAIL_FROM.
MYKHAYA_SMTP_REPLY_TO=
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
# Production: a real, deliverable MyKhaya-owned mailbox, e.g. "MyKhaya <hello@mykhaya.app>".
MYKHAYA_EMAIL_FROM=MyKhaya <hello@mykhaya.local>
# Set to false only when email ownership does not need to be enforced (for example, local development).
MYKHAYA_EMAIL_VERIFICATION_ENABLED=true
# Web Push (VAPID). Leave MYKHAYA_PUSH_DELIVERY_CONFIGURED=false to manage keys from
# the Platform Admin Push page instead.
MYKHAYA_VAPID_PUBLIC_KEY=
MYKHAYA_VAPID_PRIVATE_KEY=
MYKHAYA_VAPID_SUBJECT=
MYKHAYA_PUSH_DELIVERY_CONFIGURED=false

MYKHAYA_STRIPE_SECRET_KEY=
MYKHAYA_STRIPE_WEBHOOK_SECRET=
MYKHAYA_STRIPE_PUBLISHABLE_KEY=
MYKHAYA_STRIPE_FAMILY_MONTHLY_PRICE_ID=
MYKHAYA_STRIPE_FAMILY_ANNUAL_PRICE_ID=
MYKHAYA_STRIPE_BILLING_CONFIGURED=false
MYKHAYA_STRIPE_BILLING_ACQUISITION_ENABLED=false

# -------------------------------------------------------------------
# Driveway / DVLA Vehicle Enquiry Service
# -------------------------------------------------------------------

MYKHAYA_DVLA_ENVIRONMENT=

# DVLA UAT
MYKHAYA_DVLA_UAT_ENDPOINT=https://uat.driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
MYKHAYA_DVLA_UAT_API_KEY=

# DVLA PRODUCTION
MYKHAYA_DVLA_PRODUCTION_ENDPOINT=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles
MYKHAYA_DVLA_PRODUCTION_API_KEY=

MYKHAYA_TRUSTED_PROXY_CIDRS=["10.77.0.250/32","10.77.1.250/32"]
# Development-only loopback policy. Replace with exact operator/VPN CIDRs before production.
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
MYKHAYA_ADMIN_SESSION_IDLE_MINUTES=15
MYKHAYA_ADMIN_SESSION_ABSOLUTE_MINUTES=480
MYKHAYA_ADMIN_RECENT_AUTH_MINUTES=10
MYKHAYA_ADMIN_MFA_REQUIRED=true
MYKHAYA_ADMIN_BOOTSTRAP_ENABLED=false
MYKHAYA_STATUS_PUBLIC_ENABLED=true
# Build metadata is injected by the deployment workflow. Local development uses dev.
MYKHAYA_VERSION=dev
MYKHAYA_COMMIT_SHA=unknown
# ISO-8601 UTC timestamp (for example 2026-08-01T15:00:00Z)
MYKHAYA_BUILD_TIME=unknown
MYKHAYA_BUILD_CHANNEL=development
WEB_DOMAIN=mykhaya.app
API_DOMAIN=api.mykhaya.app
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday
ADMIN_DOMAIN=admin.mykhaya.app
STATUS_DOMAIN=status.mykhaya.app
