# Copy this file to .env and fill in the values.
#
# EXPO_PUBLIC_API_BASE_URL must point at the MyKhaya API from wherever the
# app is running. A physical phone cannot use this computer's "localhost" -
# it needs your development machine's LAN IP address instead.
#
# 1. Start the backend: make dev-up (see repo README).
# 2. Find your Windows machine's LAN IP: run `ipconfig` and use the IPv4
#    address of the network adapter your phone is also connected to
#    (usually starts 192.168.x.x or 10.x.x.x).
# 3. The port matches MYKHAYA_DEV_HOST_PORT from the root .env (default 8080).
#
# Do not commit a real IP address here - this file only holds a placeholder.
EXPO_PUBLIC_API_BASE_URL=http://192.0.2.1:8080
