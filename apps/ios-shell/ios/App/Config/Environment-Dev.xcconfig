// MyKhaya DEV app: every DEV-specific iOS value lives here and only here.
// Included by Debug-Dev.xcconfig and Release-Dev.xcconfig. Validated by
// apps/ios-shell/src/ios-environments.test.ts (any OS) and
// apps/ios-shell/scripts/validate-ios-environments.sh (Mac, expanded values).
// Changing a value here changes the installed app's identity: check
// docs/mobile/ios-environments.md first.

MYKHAYA_ENVIRONMENT = development
MYKHAYA_DISPLAY_NAME = MyKhaya-Dev
// The widget extension is $(MYKHAYA_APP_BUNDLE_ID).widgets.
MYKHAYA_APP_BUNDLE_ID = app.mykhaya.mobile
MYKHAYA_APP_GROUP = group.app.mykhaya.mobile
MYKHAYA_URL_SCHEME = mykhaya
// Host only (an xcconfig treats "//" as a comment): the app loads https://$(MYKHAYA_SERVER_HOST).
MYKHAYA_SERVER_HOST = dev.mykhaya.app

// Version and build of the DEV app and its widget (they must match). DEV may
// be a version ahead of PROD, never behind; the build restarts at 1 for each
// new version. Set them here, not in Xcode's General tab (that writes a
// target-level override, which the build-phase check rejects). See
// docs/engineering/versioning-and-releases.md.
MARKETING_VERSION = 0.1.35
CURRENT_PROJECT_VERSION = 1

DEVELOPMENT_TEAM = M86392YDLQ
CODE_SIGN_STYLE = Automatic
