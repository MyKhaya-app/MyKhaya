# Copy to keystore.properties and fill locally. This file is intentionally safe
# to commit; the copied file is ignored and must never be committed.
# Prefer an absolute path outside the repository for the keystore, or a path
# relative to apps/android-shell/android/app.
storeFile=C:/secure/mykhaya-upload-key.jks
storePassword=REPLACE_LOCALLY
keyAlias=mykhaya-upload
keyPassword=REPLACE_LOCALLY
