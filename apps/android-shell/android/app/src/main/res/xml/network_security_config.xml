<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPORARY, memory-investigation local-testing-only file (see Phase 2B and
  the follow-up WebView-OOM investigation). Permits cleartext (HTTP) traffic
  strictly to `localhost` so this debug build can reach the developer's
  local Docker Caddy stack via `adb reverse tcp:8089 tcp:8089`. Not intended
  to be committed as part of the app's normal configuration; remove this
  file and the manifest reference to it once local testing is complete.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
