# DEV Compose interpolation file -> /etc/mykhaya/dev/compose.env (mode 0644 or 0640).
# Passed with --env-file; replaces the repository root .env as Compose's
# interpolation source. Host-specific, NON-SECRET values only: the validator
# rejects any credential here. Copy each value from the current DEV root .env.
MYKHAYA_DEV_BIND_ADDRESS=0.0.0.0
MYKHAYA_DEV_HOST_PORT=8089
MYKHAYA_DEV_MAILPIT_PORT=8025
MYKHAYA_DEV_PROXY_TRUSTED_CIDRS=100.64.0.0/10
MYKHAYA_TRUSTED_PROXY_CIDRS=["10.77.0.250/32","10.77.1.250/32"]
MYKHAYA_ADMIN_ALLOWED_NETWORKS=["__SET_IN_IGNORED_DEV_FILE__/32"]
MYKHAYA_DEFAULT_TIMEZONE=Europe/London
MYKHAYA_DEFAULT_LOCALE=en-GB
MYKHAYA_WEEK_START=monday
# Shown by the web service; must match MYKHAYA_EMAIL_DELIVERY_CONFIGURED in api.env.
MYKHAYA_EMAIL_DELIVERY_CONFIGURED=false
# Read-only key mounts: absolute host paths outside the repository, which must
# exist. The documented DEV Apple key location is /etc/mykhaya/dev/apple; confirm
# the actual field-key and Apple locations on the DEV host before cutover.
MYKHAYA_FIELD_KEYS_HOST_DIR=/etc/mykhaya/dev/secrets/field-keys
MYKHAYA_APPLE_KEY_HOST_DIR=/etc/mykhaya/dev/secrets/apple
